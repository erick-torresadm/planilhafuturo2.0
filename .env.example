# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_publishable_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Efí Pagamentos
EFI_CLIENT_ID=seu_client_id
EFI_CLIENT_SECRET=seu_client_secret
EFI_PIX_KEY=sua_chave_pix
# API Pix: producao https://pix.api.efipay.com.br | homologacao https://pix-h.api.efipay.com.br
EFI_PIX_ENDPOINT=https://pix-h.api.efipay.com.br
# API Cobrancas (cartao): producao https://cobrancas.api.efipay.com.br | homologacao https://cobrancas-h.api.efipay.com.br
EFI_COBRANCAS_ENDPOINT=https://cobrancas-h.api.efipay.com.br
# Identificador de conta (payee_code) — painel Efí: API > Introdução > Identificador de conta
VITE_EFI_PAYEE_CODE=seu_payee_code
# Ambiente do tokenizador do cartão no navegador: homologacao=sandbox, producao=production (baked no build)
VITE_EFI_ENV=homologacao
# Certificado mTLS obrigatório (P12 em base64) + senha
EFI_PFX=
EFI_PFX_PASS=
# Alternativa PEM
EFI_CERT=
EFI_KEY=
